APP_NAME="Piseth.Design"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Phnom_Penh
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
# MAIL_MAILER=log does NOT send email: messages (including email-change
# confirmation codes) are only written to storage/logs/laravel.log. Fine for
# local development; never use it where real users need their codes.
#
# For real delivery set MAIL_MAILER=smtp and fill in your provider's values
# in your own .env (never commit them), for example:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null        # "smtps" for implicit TLS on port 465; null otherwise
#   MAIL_HOST=smtp.your-provider.example
#   MAIL_PORT=587
#   MAIL_USERNAME=your-smtp-username
#   MAIL_PASSWORD=your-smtp-password
#   MAIL_FROM_ADDRESS="no-reply@your-verified-domain.example"
# Then run: php artisan config:clear
# Email-change codes are sent immediately (not queued), so no queue worker is
# needed for them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin panel: IPs allowed to open /admin (comma separated). Empty = nobody.
ADMIN_ALLOWED_IPS="127.0.0.1,::1"

# Proxies allowed to say who the visitor is, comma separated, or "*" for any.
# REQUIRED once nginx, Apache or a tunnel sits in front of PHP: without it the
# app sees the proxy's address (127.0.0.1 on the same host) instead of the
# visitor's, and ADMIN_ALLOWED_IPS above would match everyone. Leave empty when
# PHP is reached directly -- admin requests that arrive forwarded are then
# refused, because the real caller cannot be known.
# Example: TRUSTED_PROXIES="127.0.0.1,::1"
TRUSTED_PROXIES=
ADMIN_VIDEO_MAX_MB=2048

# Admin account created by "php artisan db:seed" (and setup.bat).
# Choose your own password here -- never commit it. It is only used when the
# admin account is first created; it never overwrites an existing password.
# Left empty, the seeder skips the admin account and prints a warning.
ADMIN_SEED_EMAIL=admin@piseth.design
ADMIN_SEED_PASSWORD=

# --- Social Authentication (Google) ---
# Ask a team member for the shared Client ID/Secret (do not create your own
# OAuth client) - see docs/SOCIAL_AUTH_SETUP.md. Always browse the app at
# 127.0.0.1:8000, not localhost:8000 -- Google treats them as different origins
# and only 127.0.0.1:8000 is registered as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- Public social links (footer) ---
# Optional overrides for config/social.php. Facebook and Instagram already
# have real defaults in that file. Leave SOCIAL_TELEGRAM_URL empty until a
# destination is provided; the footer shows a disabled placeholder until then.
# SOCIAL_FACEBOOK_URL=
# SOCIAL_INSTAGRAM_URL=
# SOCIAL_TELEGRAM_URL=

# --- ABA PayWay KHQR payments (the live gateway) ---
# Sandbox: https://checkout-sandbox.payway.com.kh
# Live:    https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# From ABA's merchant portal. The API key is ABA's "Public Key" -- no spaces.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Public https URL of POST /payway/callback. PayWay cannot reach localhost, so
# on XAMPP run a tunnel and paste its URL here (see PAYMENTS.md section 3):
#   PAYWAY_CALLBACK_URL=https://your-tunnel.trycloudflare.com/payway/callback
PAYWAY_CALLBACK_URL=
PAYWAY_CURRENCY=USD
# Minutes the KHQR stays payable (PayWay minimum is 3).
PAYWAY_QR_LIFETIME=10
PAYWAY_TIMEOUT=15

# Fixes "cURL error 60: SSL certificate ... unable to get local issuer
# certificate". Only needed if php.ini has no curl.cainfo AND you are not on
# Laragon (Laragon's C:\laragon\etc\ssl\cacert.pem is picked up automatically).
# HTTP_CA_BUNDLE="C:\path\to\cacert.pem"
